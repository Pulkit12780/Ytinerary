# Ytinerary backend environment
# Copy to backend/.env and fill in your keys.

# Required — used by the extractor, web-search augmenter, and the realism judge.
OPENAI_API_KEY=

# Optional — richer geocoding (categories, photos, descriptions) via OpenTripMap.
# If unset, the geocoder falls back to free OpenStreetMap/Nominatim.
OPENTRIPMAP_API_KEY=

# Optional — YouTube Data API v3, used to auto-source travel videos from trip intent.
# If unset, auto-sourcing is skipped (the curated stub is used in dev) and the UI
# falls back to pasted URLs.
YOUTUBE_API_KEY=

# Recommended — Webshare residential proxy creds for transcript fetching.
# YouTube IP-blocks server-side transcript requests; without a proxy both the
# transcript API and yt-dlp fallback fail ("IpBlocked" / "confirm you're not a bot").
# Get from https://dashboard.webshare.io (Residential → Proxy Credentials).
WEBSHARE_USER=
WEBSHARE_PASS=
